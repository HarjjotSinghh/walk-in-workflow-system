{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "npx tsc --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "start:dev": "tsx watch src/server.ts",
    "server": "node dist/server.js",
    "deploy": "wrangler deploy --minify --config wrangler.toml --env=production",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "wrangler d1 migrations apply DB_PROD --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB_PROD --remote",
    "db:studio:dev": "drizzle-kit studio",
    "db:studio:prod": "NODE_ENV=production drizzle-kit studio",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@biomejs/biome": "^2.2.2",
    "@clerk/backend": "^2.23.0",
    "@hono/node-server": "^1.19.6",
    "@libsql/client": "^0.15.14",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.8.10",
    "kysely-d1": "^0.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "wrangler": "^4.32.0"
  },
  "exports": {
    ".": {
      "types": "./lib-esm/node.d.ts",
      "import": {
        "workerd": "./lib-esm/web.js",
        "deno": "./lib-esm/web.js",
        "edge-light": "./lib-esm/web.js",
        "netlify": "./lib-esm/web.js",
        "node": "./lib-esm/node.js",
        "browser": "./lib-esm/web.js",
        "default": "./lib-esm/node.js"
      },
      "require": "./lib-cjs/node.js"
    }
  }
}
